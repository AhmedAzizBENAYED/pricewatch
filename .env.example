# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pfe_db
POSTGRES_USER=pfe_user
POSTGRES_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── API ───────────────────────────────────────────────────────
DEBUG=true
# Required — the API refuses to start without it. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://app.pfe.local

# ── AI (Ollama running on the host) ───────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text:latest

# ── Optional — LangSmith tracing ──────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=pricewatch
# LANGCHAIN_API_KEY=
